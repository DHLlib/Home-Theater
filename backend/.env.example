# PostgreSQL 配置（默认）
# 也可使用 SQLite：sqlite+aiosqlite:///data/app.db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/home_theater

# 连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# 服务配置
HOST=0.0.0.0
PORT=8000

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 下载根目录（绝对路径，留空则首次使用时提示设置）
DEFAULT_DOWNLOAD_ROOT=

# 分类映射存储方式：true 使用数据库映射表，false 回退到 JSON 文件
USE_CATEGORY_MAPPING_TABLE=true

# 站点探测 / 自适应检测
PROBE_INTERVAL=600            # 站点健康探测间隔（秒）
FAIL_THRESHOLD=3             # 连续失败 N 次自动禁用站点
RECOVER_THRESHOLD=2         # 连续成功 N 次自动恢复站点
CHECK_BASE_INTERVAL=300     # 更新检测基础间隔（秒）
CHECK_MAX_INTERVAL=3600     # 更新检测最大间隔（秒，指数退避上限）

# 下载 / 推流 / 缓存
MAX_CONCURRENT_DOWNLOADS=10  # 最大同时下载任务数（NAS/低配机可调小）
SSE_HEARTBEAT_INTERVAL=30    # SSE 心跳间隔（秒）
PLAY_CACHE_TTL_SECONDS=604800  # 播放源信息缓存有效期（秒，默认 7 天）
