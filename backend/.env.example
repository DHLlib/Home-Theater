# PostgreSQL 配置（默认）
# 也可使用 SQLite：sqlite+aiosqlite:///data/app.db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/home_theater

# 连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# 服务配置
HOST=0.0.0.0
PORT=8000

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 下载根目录（绝对路径，留空则首次使用时提示设置）
DEFAULT_DOWNLOAD_ROOT=

# 分类映射存储方式：true 使用数据库映射表，false 回退到 JSON 文件
USE_CATEGORY_MAPPING_TABLE=true
